# Copy to /opt/market/.env on the server. Never commit .env.
DOMAIN=admin.example.com
PUBLIC_URL=https://admin.example.com
COOKIE_SECURE=true
ADMIN_PASSWORD=
# Fernet key; generate with scripts/setup_env.py once. Keep an offline backup.
DATA_KEY=
ADMIN_IDS=
SHOP_BOT_TOKEN=
ADMIN_BOT_TOKEN=
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=

# API Providers - configure at least one
# Jaha API
JAHA_API_KEY=

# Canboso API
CANBOSO_API_KEY=

# Publish your actual sales, refund and privacy terms before enabling sales.
SHOP_TERMS=
RUN_BOTS=true
DB_PATH=/app/data/shop.db
