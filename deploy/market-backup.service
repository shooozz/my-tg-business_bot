[Unit]
Description=Encrypted Market database backup to Google Drive
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/market
ExecStart=/usr/bin/python3 /opt/market/backup/drive_backup.py
TimeoutStartSec=3h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
